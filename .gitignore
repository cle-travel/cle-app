# Repositório PÚBLICO: só o app e o código do design entram.
# Tudo o mais desta pasta (especificação, validações com chaves de API, exemplos com dados pessoais) fica de fora.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/.github/
!/.githooks/
!/app/
!/prototipo/
!/servidor-marco/

# dentro do código do design
/prototipo/*.bak
/prototipo/index.html

# nunca, em lugar nenhum
.env
.env.*
!.env.exemplo
node_modules/
/servidor-marco/consumo/
*.pem

# segredos da conta (códigos de recuperação etc.)
/seguranca/
*recovery-codes*
